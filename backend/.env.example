# ─────────────────────────────────────────────
# AtomQuest Backend — Environment Variables
# Copy this to .env and fill in real values.
# NEVER commit the real .env file.
# ─────────────────────────────────────────────

# PostgreSQL connection string (Render Internal DB URL recommended)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# JWT signing secret — must be at least 32 random characters
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Server port (Render injects this automatically; keep 5000 for local dev)
PORT=5000

# Environment: development | production | test
NODE_ENV=development

# Google OAuth2 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=""

# Optional: comma-separated additional CORS origins
# FRONTEND_URL=https://your-custom-domain.com

# Email credentials (for Nodemailer notifications)
EMAIL_USER=""
EMAIL_PASS=""
